TZ=Asia/Shanghai

ZHIXUE_DB_HOST=127.0.0.1
ZHIXUE_DB_PORT=13306
ZHIXUE_DB_USERNAME=root
ZHIXUE_DB_PASSWORD=local-root-password

ZHIXUE_REDIS_HOST=127.0.0.1
ZHIXUE_REDIS_PORT=16379
ZHIXUE_REDIS_PASSWORD=zhixue-local-redis

ZHIXUE_NACOS_HOST=127.0.0.1
ZHIXUE_NACOS_PORT=18848
ZHIXUE_NACOS_GRPC_PORT=19848
ZHIXUE_NACOS_ADDR=${ZHIXUE_NACOS_HOST}:${ZHIXUE_NACOS_PORT}
ZHIXUE_NACOS_NAMESPACE=public
ZHIXUE_NACOS_GROUP=DEFAULT_GROUP
ZHIXUE_NACOS_CONFIG_ENABLED=false

ZHIXUE_AUTH_PORT=19100
ZHIXUE_SYSTEM_PORT=19201
ZHIXUE_COURSE_PORT=19202
ZHIXUE_MEDIA_PORT=19203
ZHIXUE_INTERACTION_PORT=19205
ZHIXUE_INTERACTION_WS_PORT=19999
ZHIXUE_ORDER_PORT=19206
ZHIXUE_MARKETING_PORT=19207
ZHIXUE_AI_PORT=19208
ZHIXUE_GATEWAY_PORT=19001

ZHIXUE_RABBITMQ_PORT=15673
ZHIXUE_RABBITMQ_MANAGEMENT_PORT=15672
ZHIXUE_RABBITMQ_USERNAME=guest
ZHIXUE_RABBITMQ_PASSWORD=guest
ZHIXUE_RABBITMQ_VHOST=/

ZHIXUE_MINIO_PORT=19000
ZHIXUE_MINIO_CONSOLE_PORT=19090
ZHIXUE_MINIO_ENDPOINT=http://127.0.0.1:${ZHIXUE_MINIO_PORT}
ZHIXUE_MINIO_EXTERNAL_URL=http://127.0.0.1:${ZHIXUE_MINIO_PORT}
ZHIXUE_MINIO_ACCESS_KEY=minioadmin
ZHIXUE_MINIO_SECRET_KEY=minioadmin123
ZHIXUE_MINIO_BUCKET=zhixue-media

ZHIXUE_ES_PORT=19200
ZHIXUE_ES_URIS=http://127.0.0.1:${ZHIXUE_ES_PORT}
ZHIXUE_ES_HEALTH_ENABLED=false


# 首次执行 scripts/local/*.sh 时会自动替换为随机值，切勿填入真实密钥后提交
ZHIXUE_JWT_SECRET=__GENERATE__
ZHIXUE_JWT_EXPIRATION=7200
ZHIXUE_INTERNAL_TOKEN=__GENERATE__

ZHIXUE_SEARCH_MODE=stub
ZHIXUE_AI_MODE=sandbox
# 阿里云百炼(DashScope) API Key：填到 local.env（已被 gitignore），切勿写在本示例文件里
ZHIXUE_DASHSCOPE_API_KEY=
ZHIXUE_DASHSCOPE_MODEL=qwen-plus
ZHIXUE_ORDER_MQ_MODE=sandbox
ZHIXUE_INTERACTION_MQ_MODE=sandbox
ZHIXUE_MEDIA_STORAGE_MODE=sandbox
ZHIXUE_MARKETING_MODE=sandbox
# 支付回调验签共享密钥，未配置则所有回调被拒绝
ZHIXUE_PAY_CALLBACK_SECRET=__GENERATE__

# AI 向量化（dimension 必须与 ES dense_vector dims 一致）
ZHIXUE_DASHSCOPE_EMBEDDING_MODEL=text-embedding-v2
ZHIXUE_EMBEDDING_DIMENSION=1536
