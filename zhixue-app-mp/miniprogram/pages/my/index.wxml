<!--pages/my/index.wxml-->
<view class="container">
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <view class="user-bg"></view>
    <view class="user-content">
      <view class="user-avatar-wrap" bindtap="onAvatarTap">
        <safe-image image-class="user-avatar" src="{{userInfo.avatar}}" fallback="/images/avatar-default.png" mode="aspectFill" />
        <view class="avatar-edit" wx:if="{{isLogin}}">
          <image class="edit-icon" src="/images/actions/camera.png" mode="aspectFit" />
        </view>
      </view>
      <view class="user-info" bindtap="onLoginTap">
        <text class="user-name">{{isLogin ? userInfo.nickname : '点击登录'}}</text>
        <text class="user-id" wx:if="{{isLogin}}">ID: {{userInfo.id}}</text>
        <text class="login-tip" wx:else="{{!isLogin}}">登录后享受更多服务</text>
      </view>
      <view class="user-arrow" wx:if="{{!isLogin}}">
        <text class="arrow-icon">></text>
      </view>
    </view>
  </view>

  <!-- 数据统计 -->
  <view class="stats-section" wx:if="{{isLogin}}">
    <view class="stats-item" bindtap="onStudyTap">
      <text class="stats-num">{{stats.studyHours || 0}}</text>
      <text class="stats-label">学习时长(小时)</text>
    </view>
    <view class="stats-item" bindtap="onCourseTap">
      <text class="stats-num">{{stats.courseCount || 0}}</text>
      <text class="stats-label">我的课程</text>
    </view>
    <view class="stats-item" bindtap="onOrderTap">
      <text class="stats-num">{{stats.orderCount || 0}}</text>
      <text class="stats-label">我的订单</text>
    </view>
    <view class="stats-item" bindtap="onCollectTap">
      <text class="stats-num">{{stats.collectCount || 0}}</text>
      <text class="stats-label">我的收藏</text>
    </view>
  </view>

  <!-- 我的订单 -->
  <view class="menu-section">
    <view class="section-header">
      <text class="section-title">我的订单</text>
      <text class="section-more" bindtap="onAllOrderTap">查看全部 ></text>
    </view>
    <view class="order-menu">
      <view class="order-item" bindtap="onOrderStatusTap" data-status="0">
        <view class="order-icon-wrap">
          <image class="order-icon" src="/images/actions/cart.png" mode="aspectFit" />
          <view class="order-badge" wx:if="{{orderStats.unpaid > 0}}">{{orderStats.unpaid}}</view>
        </view>
        <text class="order-label">待付款</text>
      </view>
      <view class="order-item" bindtap="onOrderStatusTap" data-status="1">
        <view class="order-icon-wrap">
          <image class="order-icon" src="/images/actions/paid.png" mode="aspectFit" />
        </view>
        <text class="order-label">已付款</text>
      </view>
      <view class="order-item" bindtap="onOrderStatusTap" data-status="2">
        <view class="order-icon-wrap">
          <image class="order-icon" src="/images/actions/complete.png" mode="aspectFit" />
        </view>
        <text class="order-label">已取消</text>
      </view>
      <view class="order-item" bindtap="onAfterSaleTap">
        <view class="order-icon-wrap">
          <image class="order-icon" src="/images/actions/refund.png" mode="aspectFit" />
        </view>
        <text class="order-label">售后/退款</text>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="section-title">常用功能</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="onStudyRecordTap">
        <view class="menu-icon-wrap">
          <image class="menu-icon" src="/images/actions/records.png" mode="aspectFit" />
        </view>
        <text class="menu-label">学习记录</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="onMyCourseTap">
        <view class="menu-icon-wrap">
          <image class="menu-icon" src="/images/actions/courses.png" mode="aspectFit" />
        </view>
        <text class="menu-label">我的课程</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="onMyCollectTap">
        <view class="menu-icon-wrap">
          <image class="menu-icon" src="/images/actions/favorite.png" mode="aspectFit" />
        </view>
        <text class="menu-label">我的收藏</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="onCouponTap">
        <view class="menu-icon-wrap">
          <image class="menu-icon" src="/images/actions/coupon.png" mode="aspectFit" />
        </view>
        <text class="menu-label">优惠券</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="onAiTap">
        <view class="menu-icon-wrap">
          <image class="menu-icon" src="/images/actions/ai.png" mode="aspectFit" />
        </view>
        <text class="menu-label">AI 课程助教</text>
        <text class="menu-arrow">></text>
      </view>
    </view>
  </view>

  <!-- 更多服务 -->
  <view class="menu-section">
    <view class="section-title">更多服务</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="onContactTap">
        <view class="menu-icon-wrap">
          <image class="menu-icon" src="/images/actions/contact.png" mode="aspectFit" />
        </view>
        <text class="menu-label">联系客服</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="onFeedbackTap">
        <view class="menu-icon-wrap">
          <image class="menu-icon" src="/images/actions/feedback.png" mode="aspectFit" />
        </view>
        <text class="menu-label">意见反馈</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="onAboutTap">
        <view class="menu-icon-wrap">
          <image class="menu-icon" src="/images/actions/about.png" mode="aspectFit" />
        </view>
        <text class="menu-label">关于我们</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="onSettingTap">
        <view class="menu-icon-wrap">
          <image class="menu-icon" src="/images/actions/settings.png" mode="aspectFit" />
        </view>
        <text class="menu-label">设置</text>
        <text class="menu-arrow">></text>
      </view>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section" wx:if="{{isLogin}}">
    <button class="logout-btn" bindtap="onLogoutTap">退出登录</button>
  </view>

  <!-- 底部安全区域 -->
  <view class="safe-area"></view>
</view>
