.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--bg-color);
}

.scope {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 30rpx;
  background-color: var(--white);
  border-bottom: 1rpx solid var(--border-color);
  font-size: 26rpx;
}

.scope-label {
  color: var(--text-color-disabled);
}

.scope-value {
  flex: 1;
  color: var(--text-color);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.messages {
  flex: 1;
  height: 0;
  padding: 24rpx 30rpx 0;
  box-sizing: border-box;
}

.welcome {
  padding: 80rpx 20rpx 40rpx;
  text-align: center;
}

.welcome-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-color);
}

.welcome-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-color-disabled);
}

.suggestions {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.suggestion {
  padding: 20rpx 28rpx;
  background-color: var(--white);
  border: 1rpx solid var(--border-color);
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--primary-color);
}

.msg {
  display: flex;
  margin-bottom: 28rpx;
}

.msg.user {
  justify-content: flex-end;
}

.bubble {
  max-width: 80%;
  padding: 20rpx 26rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
}

.msg.user .bubble {
  background-color: var(--primary-color);
  color: var(--white);
  border-bottom-right-radius: 6rpx;
}

.msg.assistant .bubble {
  background-color: var(--white);
  color: var(--text-color);
  border-bottom-left-radius: 6rpx;
}

.msg.failed .bubble {
  background-color: #fff1f0;
  color: var(--error-color);
}

.bubble.thinking {
  color: var(--text-color-disabled);
}

.meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-color-disabled);
}

.save-warning {
  margin-top: 8rpx;
  padding: 12rpx 16rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #b45309;
  background-color: #fffbeb;
  border: 1rpx solid #fde68a;
  border-radius: 8rpx;
}

.bottom-spacer {
  height: 24rpx;
}

.composer {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background-color: var(--white);
  border-top: 1rpx solid var(--border-color);
}

.composer-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 24rpx;
  background-color: var(--bg-color);
  border-radius: 36rpx;
  font-size: 28rpx;
}

.composer-send {
  flex: 0 0 140rpx;
  width: 140rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  color: var(--white);
  background-color: var(--primary-color);
  border-radius: 36rpx;
}

.composer-send[disabled] {
  color: var(--white) !important;
  background-color: #a0cfff !important;
}

.toolbar {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: #fff;
}

.toolbar button {
  margin: 0;
}

.history {
  max-height: 360rpx;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
  background: #fff;
}

.history-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0;
}

.history-title {
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.history-row button {
  margin: 0;
  flex-shrink: 0;
}

.failure {
  color: var(--error-color);
  margin-top: 12rpx;
}

.recommendation {
  margin-top: 20rpx;
  border: 1rpx solid var(--border-color);
  border-radius: 12rpx;
  overflow: hidden;
}

.card-heading {
  display: flex;
  padding: 16rpx;
  gap: 16rpx;
}

.card-cover {
  width: 130rpx;
  height: 80rpx;
  border-radius: 8rpx;
}

.card-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.card-title {
  font-size: 26rpx;
  font-weight: 600;
}

.card-price {
  font-size: 24rpx;
  color: var(--primary-color);
}

.card-lesson {
  display: flex;
  flex-direction: column;
  padding: 16rpx;
  border-top: 1rpx solid var(--border-color);
  font-size: 24rpx;
}

.lesson-access {
  color: var(--primary-color);
  margin-top: 6rpx;
}
