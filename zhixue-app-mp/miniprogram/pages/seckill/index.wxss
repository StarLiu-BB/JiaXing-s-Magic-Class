.container {
  padding: 24rpx;
  min-height: 100vh;
  background: #f5f5f5;
  box-sizing: border-box;
}

.loading,
.empty {
  padding: 120rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.card {
  display: flex;
  margin-bottom: 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #fff;
}

.cover {
  width: 220rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}

.cover-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #ff4d4f 0%, #ff7a45 100%);
}

.info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.activity {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #ff4d4f;
}

.price-row {
  margin-top: 12rpx;
  display: flex;
  align-items: baseline;
}

.seckill-price {
  font-size: 36rpx;
  font-weight: 700;
  color: #ff4d4f;
}

.original-price {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #999;
  text-decoration: line-through;
}

.meta-row {
  margin-top: 8rpx;
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #666;
}

.buy-btn {
  margin: 16rpx 0 0;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #fff;
  background: linear-gradient(135deg, #ff4d4f 0%, #ff7a45 100%);
}

.buy-btn::after {
  border: none;
}

.buy-btn.disabled,
.buy-btn[disabled] {
  background: #d9d9d9 !important;
  color: #fff !important;
}
